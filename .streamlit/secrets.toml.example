# Copy this file to .streamlit/secrets.toml (local dev) and fill in real values,
# OR set the same keys as environment variables / platform "secrets" when deploying.
# .streamlit/secrets.toml itself is gitignored — never commit real keys.

# Required
GROQ_API_KEY = "your-groq-api-key"

# Optional — each feature degrades gracefully (shown as disabled in the sidebar) if left blank.
OPENWEATHER_API_KEY = ""
GMAIL_ADDRESS = ""
GMAIL_APP_PASSWORD = ""
NEWS_API_KEY = ""
TAVILY_API_KEY = ""
GOOGLE_CALENDAR_CREDENTIALS_PATH = ""
GOOGLE_CALENDAR_TOKEN_PATH = "token.json"

# --- Multi-user / public deployment -----------------------------------------

# Comma-separated emails allowed to use Gmail-send / Calendar tools and see the
# admin badge. Leave blank and NO ONE can use those two tools (safest default).
ADMIN_EMAILS = "you@gmail.com"

# Per-user rate limits — tune these to your Groq plan's actual quota.
RATE_LIMIT_PER_MINUTE = "6"
DAILY_REQUEST_LIMIT = "50"
DAILY_TOKEN_LIMIT = "100000"

# Google Sign-In (required for real deployments — see README.md "Authentication
# setup" for how to create these in Google Cloud Console). Leave this whole
# section out entirely to run in insecure "dev mode" (fine for local testing only).
# Streamlit's built-in st.login() needs redirect_uri + cookie_secret, and (since
# we use a single, unnamed/default provider) client_id/client_secret/
# server_metadata_url all live flat inside [auth] too — NOT in a nested
# [auth.google] table, that's only for naming *multiple* providers at once.
# [auth]
# redirect_uri = "http://localhost:8501/oauth2callback"   # prod: "https://yourapp.streamlit.app/oauth2callback"
# cookie_secret = "generate-a-long-random-string-here"
# client_id = "your-client-id.apps.googleusercontent.com"
# client_secret = "your-client-secret"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
